{
  "name": "dev-pad",
  "version": "0.5.0",
  "description": "A shared development dashboard for your services",
  "type": "module",
  "license": "MIT",
  "bin": {
    "devpad": "dist/cli.js",
    "dev-pad": "dist/cli.js",
    "dpad": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "default": "./dist/expo.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/dashboard.png",
    "docs/overview.png",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "check": "tsc --noEmit && biome check .",
    "check:fix": "tsc --noEmit && biome check --write .",
    "test": "node --test test/smoke.mjs test/lifecycle.mjs test/expo.mjs test/ports.mjs",
    "test:package-managers": "node --test test/package-managers.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs && npm run check && npm run build && npm test",
    "version-packages": "changeset version && bun install --lockfile-only --ignore-scripts",
    "release": "npm publish && changeset git-tag",
    "publish:branch": "node scripts/publish-branch.mjs",
    "test:ui": "python3 test/ui.py",
    "example:start": "bun run build && bun run --cwd example dev",
    "test:example": "node test/example.mjs",
    "check:example": "tsc --noEmit --project example/tsconfig.json"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "tsx": "^4.20.5"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "typescript": "7.0.2"
  },
  "author": "James Waterhouse <09jwater@gmail.com>",
  "repository": "https://github.com/Censkh/dev-pad",
  "homepage": "https://github.com/Censkh/dev-pad#readme",
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "dashboard",
    "development",
    "services",
    "process-manager",
    "typescript",
    "bun",
    "node",
    "deno"
  ]
}
